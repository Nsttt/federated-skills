{
  "name": "@module-federation/mcp",
  "version": "0.1.0",
  "description": "Ship agent skills and tools from Module Federation remotes, and serve them over MCP: with the ready-made gateway, or from your own MCP server.",
  "type": "module",
  "author": "module-federation",
  "license": "MIT",
  "keywords": [
    "module-federation",
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "skills",
    "effect",
    "rsbuild"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "federated-skills": "./bin/federated-skills.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "raw.d.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "require": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect/index.d.ts",
        "default": "./dist/effect.js"
      },
      "require": {
        "types": "./dist/effect/index.d.ts",
        "default": "./dist/effect.cjs"
      }
    },
    "./build": {
      "import": {
        "types": "./dist/build.d.ts",
        "default": "./dist/build.js"
      },
      "require": {
        "types": "./dist/build.d.ts",
        "default": "./dist/build.cjs"
      }
    },
    "./rsbuild": {
      "import": {
        "types": "./dist/rsbuild.d.ts",
        "default": "./dist/rsbuild.js"
      },
      "require": {
        "types": "./dist/rsbuild.d.ts",
        "default": "./dist/rsbuild.cjs"
      }
    },
    "./protocol": {
      "import": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.js"
      },
      "require": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.cjs"
      }
    },
    "./package.json": "./package.json",
    "./raw": {
      "types": "./raw.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ],
      "build": [
        "./dist/build.d.ts"
      ],
      "protocol": [
        "./dist/protocol.d.ts"
      ],
      "raw": [
        "./raw.d.ts"
      ],
      "rsbuild": [
        "./dist/rsbuild.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rslib build",
    "test": "rstest",
    "lint": "rslint",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "@module-federation/runtime": "^2.9.2",
    "@module-federation/sdk": "^2.9.2",
    "yaml": "^2.8.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@module-federation/enhanced": "2.9.2",
    "@module-federation/node": "2.7.52",
    "@module-federation/rsbuild-plugin": "2.9.2",
    "@rsbuild/core": "2.2.11",
    "@rslib/core": "1.0.3",
    "@rslint/core": "0.9.4",
    "@rstest/core": "^0.10.6",
    "@types/node": "^20.19.5",
    "effect": "4.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.0.0",
    "@module-federation/enhanced": "^2.9.2",
    "@module-federation/node": "^2.7.0",
    "@module-federation/rsbuild-plugin": "^2.9.2",
    "@rsbuild/core": "^1.3.21 || ^2.0.0",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "@module-federation/enhanced": {
      "optional": true
    },
    "@module-federation/node": {
      "optional": true
    },
    "@module-federation/rsbuild-plugin": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  }
}
